# Credenciais server-side. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
IMPERIO_MANAGER_EMAIL=
IMPERIO_MANAGER_FULL_NAME=
IMPERIO_MANAGER_TEMPORARY_PASSWORD=

ESTOQUENOW_CLIENT_ID=
ESTOQUENOW_CLIENT_SECRET=
ESTOQUENOW_API_URL=https://api.estoquenow.com.br
# Importação individual revisada na torre.
ESTOQUENOW_IMPORT_ENABLED=false
# Pull agendado: começa em observação; aplicação exige flag separada e lote de 1 a 5.
ESTOQUENOW_INCREMENTAL_PULL_ENABLED=false
ESTOQUENOW_PULL_APPLY_ENABLED=false
ESTOQUENOW_PULL_MANAGER_ID=
ESTOQUENOW_PULL_LOOKBACK_DAYS=1
ESTOQUENOW_PULL_LOOKAHEAD_DAYS=90
ESTOQUENOW_PULL_BATCH_SIZE=5
# Gerado fora do Git, com pelo menos 16 caracteres, para autenticar o Vercel Cron.
CRON_SECRET=
# Escrita de entrega/devolução no EstoqueNOW continua independente e bloqueada.
ESTOQUENOW_WRITE_ENABLED=false
